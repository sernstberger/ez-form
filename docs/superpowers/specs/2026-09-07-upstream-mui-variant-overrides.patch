+// testing docs/data/material/components/text-fields/text-fields.md#custom-variants
+import * as React from 'react';
+import { expectType } from '@mui/types';
+import { createTheme } from '@mui/material/styles';
+import TextField, { TextFieldProps, TextFieldVariants } from '@mui/material/TextField';
+import InputBase, { InputBaseProps } from '@mui/material/InputBase';
+
+// Update the TextField's variant prop options
+declare module '@mui/material/TextField' {
+  interface TextFieldPropsVariantOverrides {
+    dashed: true;
+  }
+}
+
+const theme = createTheme({
+  components: {
+    MuiTextField: {
+      variants: [
+        {
+          props: { variant: 'dashed' },
+          style: { border: '1px dashed' },
+        },
+      ],
+    },
+  },
+});
+
+// The augmented variant joins the union.
+{
+  const variant = 'dashed' as TextFieldVariants;
+  expectType<'outlined' | 'standard' | 'filled' | 'dashed', typeof variant>(variant);
+}
+
+// A custom variant resolves to the custom arm, whose props are based on `InputBase`
+// because that is what `TextField` renders for an unknown variant.
+{
+  const custom: TextFieldProps<'dashed'> = {
+    variant: 'dashed',
+    slots: { input: InputBase },
+  };
+  const onChange = custom.onChange;
+  expectType<InputBaseProps['onChange'], typeof onChange>(onChange);
+}
+
+// The built-in arms are unaffected by the augmentation.
+{
+  const filled: TextFieldProps<'filled'> = {
+    variant: 'filled',
+    slotProps: { input: { classes: { adornedStart: 'adorned-start' } } },
+  };
+  const outlined: TextFieldProps<'outlined'> = {
+    variant: 'outlined',
+    slotProps: { input: { classes: { notchedOutline: 'notched-outline' } } },
+  };
+  const standard: TextFieldProps<'standard'> = {
+    variant: 'standard',
+    slotProps: { input: { classes: { inputTypeSearch: 'search-input' } } },
+  };
+}
+
+<TextField variant="dashed" label="Dashed" />;
+<TextField variant="dashed" slots={{ input: InputBase }} />;
+<TextField variant="outlined" label="Outlined" />;
+<TextField label="Default" />;
+
+/* A variant that was never augmented is still rejected */
+// @ts-expect-error
+<TextField variant="dashd" />;
