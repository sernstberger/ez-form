@@ -0,0 +1,20 @@
+import * as React from 'react';
+import FormControl from '@mui/material/FormControl';
+
+// Adding a `FormControl` variant, for consumers composing `FormControl` directly,
+// requires augmenting this interface and nothing else.
+declare module '@mui/material/FormControl' {
+  interface FormControlPropsVariantOverrides {
+    plain: true;
+  }
+}
+
+<FormControl variant="plain" />;
+
+// The built-in variants keep working.
+<FormControl variant="outlined" />;
+<FormControl variant="filled" />;
+<FormControl variant="standard" />;
+
+// @ts-expect-error a variant that was never added is still rejected
+<FormControl variant="plane" />;
