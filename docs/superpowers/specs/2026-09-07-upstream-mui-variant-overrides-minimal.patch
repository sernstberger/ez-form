+import * as React from 'react';
+import { createTheme } from '@mui/material/styles';
+import TextField from '@mui/material/TextField';
+
+// Adding a `TextField` variant requires augmenting this interface and nothing else.
+declare module '@mui/material/TextField' {
+  interface TextFieldPropsVariantOverrides {
+    dashed: true;
+  }
+}
+
+<TextField variant="dashed" />;
+
+// The built-in variants keep working.
+<TextField variant="outlined" />;
+<TextField variant="filled" />;
+<TextField variant="standard" />;
+
+// @ts-expect-error a variant that was never added is still rejected
+<TextField variant="dashd" />;
+
+// A custom variant is styled through `theme.components.MuiTextField.variants`.
+createTheme({
+  components: {
+    MuiTextField: {
+      variants: [
+        {
+          props: { variant: 'dashed' },
+          style: {},
+        },
+      ],
+    },
+  },
+});
